# =============================================================================
# .env.example · 环境变量模板（这个文件可以提交到 Git）
# =============================================================================
# 用法：复制成 .env 再改成你自己的值：
#     cp .env.example .env        # Windows: copy .env.example .env
#
# ⚠️ 真正的 .env 绝对不能提交！仓库根目录的 .gitignore 已经忽略它，
#    提交前请用 `git status` 确认看不到 .env。
# ⚠️ 这里全是假值，不含任何真实密钥。
# =============================================================================

# ---------- 数据库 ----------
# 格式：mysql+pymysql://用户名:密码@主机:端口/库名?charset=utf8mb4
# 密码里如果有 @ : / 等特殊字符，需要做 URL 编码（@ → %40）
DATABASE_URL=mysql+pymysql://root:your_password_here@127.0.0.1:3306/library?charset=utf8mb4

# ---------- JWT（阶段 5）----------
# ⚠️ 必须是随机强密钥，不要手打 "secret123"。
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ 改动 JWT_SECRET = 所有已签发的 Token 立即失效 = 全部用户被强制登出。
JWT_SECRET=change-me-generate-with-secrets-token-urlsafe-48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- 其他 ----------
# 是否打印真实 SQL（开发时 true，方便数 SQL 条数；生产必须 false）
SQL_ECHO=false

# bcrypt 代价因子：每 +1 耗时翻倍。12 大约 200~300 ms，是登录接口能接受的甜点
BCRYPT_ROUNDS=12

# CORS 白名单，逗号分隔。Vite 默认跑在 5173
# ❌ 绝不要写 * 同时开 allow_credentials=True，浏览器会直接拒绝
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
